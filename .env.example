# Скопируйте этот файл в .env и подставьте свои значения.
# Сам .env в репозиторий не попадает.

DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# По умолчанию — SQLite (db.sqlite3 рядом с manage.py)
# DATABASE_URL=postgres://user:password@localhost:5432/quixzet

# REDIS_URL=redis://127.0.0.1:6379/1

